# =============================================================================
# Root Workspace .gitignore (Covers Root + DEMODESIGN-A / B / C)
# Standard Node.js, TypeScript, Vite, IDE & OS ignore rules
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.npm/
.eslintcache
.stylelintcache

# Production & Vite Build Outputs
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Local Secrets
.env
.env.*
!.env.example
!.env.sample
*.local

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-Generated Files (Windows, macOS, Linux)
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# Temporary & Cache Folders
.cache/
.parcel-cache/
.temp/
.tmp/
tmp/

